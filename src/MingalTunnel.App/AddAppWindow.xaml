<Window x:Class="MingalTunnel.App.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar app ao túnel" Width="760" Height="620" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate x:Key="CandidateTemplate">
            <Grid Margin="4,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" Margin="8,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource SubInk}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnText}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource CandidateTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>
    <Border Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Hint}" FontSize="13"
                   Text="Marque o que deve passar pelo túnel. Qualquer programa funciona (jogos inclusive). Pra jogos com launcher e vários .exe, use 'Escolher pasta'." />
        <Grid Grid.Row="1" Margin="0,12,0,8">
            <TextBox x:Name="Filter" TextChanged="OnFilterChanged" />
            <TextBlock Text="Filtrar por nome ou caminho…" Foreground="#A3A1AA" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       x:Name="FilterHint" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10,4,10,10">
            <TabControl>
                <TabItem Header="Usando a rede agora">
                    <Grid>
                        <ListBox x:Name="NetworkList" Margin="0,8,0,0" />
                        <TextBlock x:Name="NetworkLoading" Text="Carregando…" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </TabItem>
                <TabItem Header="Menu Iniciar">
                    <Grid>
                        <ListBox x:Name="StartMenuList" Margin="0,8,0,0" />
                        <TextBlock x:Name="StartMenuLoading" Text="Carregando…" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Escolher .exe…" Click="OnBrowseExe" DockPanel.Dock="Left" />
            <Button Style="{StaticResource SecondaryButton}" Content="Escolher pasta…" Click="OnBrowseFolder" DockPanel.Dock="Left" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="Cancelar" IsCancel="True" Padding="14,7" />
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Adicionar" Click="OnAdd" Margin="8,0,0,0" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </Border>
</Window>
