<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MingalTunnel</AssemblyName>
    <RootNamespace>MingalTunnel.App</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Mingal Tunnel</AssemblyTitle>
  </PropertyGroup>

  <!-- Debug runs unelevated so the UI can be worked on without UAC; the tunnel itself refuses to start there. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="assets\app.ico" />
    <Resource Include="..\..\assets\app_logo.png" Link="assets\app_logo.png" />
    <Resource Include="..\..\assets\avatar.png" Link="assets\avatar.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\engine\sing-box.exe" Link="engine\sing-box.exe" Condition="Exists('..\..\third_party\engine\sing-box.exe')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\third_party\engine\wintun.dll" Link="engine\wintun.dll" Condition="Exists('..\..\third_party\engine\wintun.dll')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MingalTunnel.Core\MingalTunnel.Core.csproj" />
  </ItemGroup>
</Project>
